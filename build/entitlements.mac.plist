<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The first three are electron-builder's defaults for a hardened-runtime mac
  build; naming this file replaces them wholesale, so they have to be repeated
  here rather than merged.

  apple-events is the addition. Handing a ticket to Terminal goes through
  osascript, and under the hardened runtime an un-entitled app cannot send Apple
  Events at all — TCC attributes the event to Project Tracker, not to osascript.
  Warp and Ghostty are launched through Launch Services and need none of this.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
